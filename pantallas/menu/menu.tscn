[gd_scene format=3]

[ext_resource type="Script" path="res://pantallas/menu/menu.gd" id="1"]
[ext_resource type="Theme" path="res://interfaz/tema_xalapa.tres" id="2"]
[ext_resource type="PackedScene" path="res://mundo/paisaje/paisaje.tscn" id="paisaje"]
[ext_resource type="PackedScene" path="res://mundo/terreno/tramo.tscn" id="tramo"]
[ext_resource type="Script" path="res://mundo/terreno/bajada_xallitic.gd" id="bajada"]
[ext_resource type="Script" path="res://pantallas/menu/melones_menu.gd" id="melones"]
[ext_resource type="Script" path="res://pantallas/menu/titulo_melonazo.gd" id="titulo"]
[ext_resource type="Script" path="res://pantallas/menu/cielo_menu.gd" id="cielo"]
[ext_resource type="Texture2D" path="res://recursos/iconos/jugar.png" id="ico_jugar"]

[node name="Menu" type="Node2D"]
script = ExtResource("1")

[node name="Paisaje" parent="." instance=ExtResource("paisaje")]

[node name="CieloAlto" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("cielo")

[node name="Mundo" type="Node2D" parent="."]

[node name="BajadaXallitic" parent="Mundo" instance=ExtResource("tramo")]
unique_name_in_owner = true
script = ExtResource("bajada")

[node name="Melones" type="Node2D" parent="Mundo"]
unique_name_in_owner = true
script = ExtResource("melones")

[node name="Camara" type="Camera2D" parent="."]
unique_name_in_owner = true

[node name="Interfaz" type="CanvasLayer" parent="."]

[node name="Centro" type="VBoxContainer" parent="Interfaz"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 50.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2")
theme_override_constants/separation = 50

[node name="Titulo" type="Control" parent="Interfaz/Centro"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("titulo")

[node name="BtnJugar" type="Button" parent="Interfaz/Centro"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 88)
layout_mode = 2
size_flags_horizontal = 4
theme_type_variation = &"Principal"
theme_override_font_sizes/font_size = 38
text = "Jugar"
icon = ExtResource("ico_jugar")

[connection signal="pressed" from="Interfaz/Centro/BtnJugar" to="." method="_jugar"]
