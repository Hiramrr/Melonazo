[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://pantallas/taller/pestanas/pestana_dibujo.gd" id="1"]

[sub_resource type="ButtonGroup" id="Herramientas"]

[node name="Dibujo" type="ScrollContainer"]
horizontal_scroll_mode = 0
script = ExtResource("1")

[node name="Caja" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Nota" type="Label" parent="Caja"]
layout_mode = 2
theme_type_variation = &"Suave"
text = "Pinta sobre tu melón. Se guarda al soltar el pincel. Ctrl+Z para deshacer."
autowrap_mode = 2

[node name="EtiHerramienta" type="Label" parent="Caja"]
layout_mode = 2
theme_type_variation = &"Subtitulo"
theme_override_font_sizes/font_size = 18
text = "Herramienta"

[node name="FilaHerramientas" type="HBoxContainer" parent="Caja"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Pincel" type="Button" parent="Caja/FilaHerramientas"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_pressed = true
button_group = SubResource("Herramientas")
text = "Pincel"

[node name="Goma" type="Button" parent="Caja/FilaHerramientas"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
toggle_mode = true
button_group = SubResource("Herramientas")
text = "Goma"

[node name="EtiColor" type="Label" parent="Caja"]
layout_mode = 2
theme_type_variation = &"Subtitulo"
theme_override_font_sizes/font_size = 18
text = "Color"

[node name="FilaColores" type="HFlowContainer" parent="Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="FilaOtro" type="HBoxContainer" parent="Caja"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="EtiOtro" type="Label" parent="Caja/FilaOtro"]
layout_mode = 2
theme_type_variation = &"Subtitulo"
theme_override_font_sizes/font_size = 16
text = "Otro color"

[node name="OtroColor" type="ColorPickerButton" parent="Caja/FilaOtro"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 42)
layout_mode = 2
color = Color(0.146, 0.243, 0.196, 1)
edit_alpha = false

[node name="FilaGrosor" type="HBoxContainer" parent="Caja"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="EtiGrosor" type="Label" parent="Caja/FilaGrosor"]
layout_mode = 2
theme_type_variation = &"Subtitulo"
theme_override_font_sizes/font_size = 18
text = "Grosor"

[node name="Grosor" type="HSlider" parent="Caja/FilaGrosor"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
min_value = 0.03
max_value = 0.3
step = 0.01
value = 0.08

[node name="FilaAcciones" type="HBoxContainer" parent="Caja"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Deshacer" type="Button" parent="Caja/FilaAcciones"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Deshacer trazo"

[node name="Borrar" type="Button" parent="Caja/FilaAcciones"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Borrar todo"

[node name="Conteo" type="Label" parent="Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Suave"
text = "Sin trazos todavía."

[connection signal="color_changed" from="Caja/FilaOtro/OtroColor" to="." method="_elegir_color"]
[connection signal="value_changed" from="Caja/FilaGrosor/Grosor" to="." method="_cambiar_grosor"]
[connection signal="pressed" from="Caja/FilaAcciones/Deshacer" to="." method="deshacer"]
[connection signal="pressed" from="Caja/FilaAcciones/Borrar" to="." method="borrar_todo"]
