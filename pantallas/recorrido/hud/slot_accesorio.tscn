[gd_scene format=3]

[ext_resource type="Script" path="res://pantallas/recorrido/hud/slot_accesorio.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="Casilla"]
content_margin_left = 6.0
content_margin_top = 6.0
content_margin_right = 6.0
content_margin_bottom = 8.0
bg_color = Color(0.09, 0.18, 0.165, 0.78)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 6
border_color = Color(1, 0.976, 0.925, 0.9)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[node name="SlotAccesorio" type="PanelContainer"]
custom_minimum_size = Vector2(80, 84)
mouse_filter = 1
theme_override_styles/panel = SubResource("Casilla")
script = ExtResource("1")

[node name="Caja" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0
alignment = 1

[node name="Icono" type="Control" parent="Caja"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
mouse_filter = 2

[node name="Nombre" type="Label" parent="Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TextoHUD"
theme_override_font_sizes/font_size = 13
theme_override_constants/outline_size = 5
text = "Vacío"
horizontal_alignment = 1
clip_text = true

[node name="Tecla" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
theme_type_variation = &"Tecla"
theme_override_font_sizes/font_size = 13
text = "1"

[connection signal="draw" from="Caja/Icono" to="." method="_dibujar_icono"]
