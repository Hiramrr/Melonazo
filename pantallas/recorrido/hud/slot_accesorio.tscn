[gd_scene format=3]

[ext_resource type="Script" path="res://pantallas/recorrido/hud/slot_accesorio.gd" id="1"]

[node name="SlotAccesorio" type="PanelContainer"]
theme_type_variation = &"CasillaAccesorio"
custom_minimum_size = Vector2(80, 84)
mouse_filter = 1
script = ExtResource("1")

[node name="Caja" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0
alignment = 1

[node name="Icono" type="Control" parent="Caja"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
mouse_filter = 2

[node name="Nombre" type="Label" parent="Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"NombreAccesorio"
text = "Vacío"
horizontal_alignment = 1
clip_text = true

[node name="Tecla" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 0
theme_type_variation = &"TeclaAccesorio"
text = "1"

[connection signal="draw" from="Caja/Icono" to="." method="_dibujar_icono"]
