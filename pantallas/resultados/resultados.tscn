[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://pantallas/resultados/resultados.gd" id="1"]
[ext_resource type="Theme" path="res://interfaz/tema_xalapa.tres" id="2"]
[ext_resource type="Script" path="res://pantallas/resultados/postal_resultados.gd" id="3"]

[node name="Resultados" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Fondo" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.96, 0.94, 0.87, 1)

[node name="Margen" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Columnas" type="HBoxContainer" parent="Margen"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Postal" type="Control" parent="Margen/Columnas"]
layout_mode = 2
custom_minimum_size = Vector2(300, 0)
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.85
clip_contents = true
script = ExtResource("3")

[node name="Centro" type="CenterContainer" parent="Margen/Columnas"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caja" type="VBoxContainer" parent="Margen/Columnas/Centro"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Etiqueta" type="Label" parent="Margen/Columnas/Centro/Caja"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.365, 0.435, 0.396, 1)
text = "Tu recorrido por Xalapa"

[node name="Titulo" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Fin del recorrido"
autowrap_mode = 2
theme_type_variation = &"Titulo"

[node name="Nombre" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Melón"
autowrap_mode = 2

[node name="Distancia" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 96
text = "0 m"
autowrap_mode = 2
theme_type_variation = &"Titulo"

[node name="Record" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Récord: 0 m"
autowrap_mode = 2

[node name="Carisma" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Carisma conservado: 0"
autowrap_mode = 2

[node name="Separador" type="HSeparator" parent="Margen/Columnas/Centro/Caja"]
layout_mode = 2

[node name="ListaAplausos" type="VBoxContainer" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Total" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "0 aplausos"

[node name="Ahora" type="Label" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Saldo: 0 aplausos"

[node name="BtnVolver" type="Button" parent="Margen/Columnas/Centro/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Principal"
theme_override_font_sizes/font_size = 20
text = "Preparar otra vuelta   →"

[connection signal="pressed" from="Margen/Columnas/Centro/Caja/BtnVolver" to="." method="_volver"]
