[gd_scene format=3]

[ext_resource type="Script" path="res://pantallas/resultados/resultados.gd" id="1"]
[ext_resource type="Script" path="res://pantallas/resultados/postal_resultados.gd" id="3"]
[ext_resource type="Script" path="res://interfaz/fondo_juego.gd" id="fondo"]
[ext_resource type="Texture2D" path="res://recursos/iconos/aplauso.png" id="ico_aplauso"]
[ext_resource type="Texture2D" path="res://recursos/iconos/jugar.png" id="ico_jugar"]

[node name="Resultados" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Fondo" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("fondo")
theme_type_variation = &"FondoResultados"
centro_rayos = Vector2(0.72, 0.42)
ancho_bandera = 30.0
caida = 6.0

[node name="Margen" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 52
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Columnas" type="HBoxContainer" parent="Margen"]
layout_mode = 2
theme_override_constants/separation = 44

[node name="Postal" type="Control" parent="Margen/Columnas"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.85
script = ExtResource("3")

[node name="Derecha" type="VBoxContainer" parent="Margen/Columnas"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = -26

[node name="Cinta" type="PanelContainer" parent="Margen/Columnas/Derecha"]
theme_type_variation = &"CintaResultados"
unique_name_in_owner = true
z_index = 1
layout_mode = 2
size_flags_horizontal = 4

[node name="Titulo" type="Label" parent="Margen/Columnas/Derecha/Cinta"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TituloPanel"
text = "Fin del recorrido"
horizontal_alignment = 1

[node name="Tarjeta" type="PanelContainer" parent="Margen/Columnas/Derecha"]
theme_type_variation = &"PanelResultados"
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Caja" type="VBoxContainer" parent="Margen/Columnas/Derecha/Tarjeta"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Nombre" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Subtitulo"
text = "Melón"
horizontal_alignment = 1
text_overrun_behavior = 3

[node name="FilaDistancia" type="HBoxContainer" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 14

[node name="Distancia" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja/FilaDistancia"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DistanciaResultado"
text = "0 m"
horizontal_alignment = 1

[node name="Record" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja/FilaDistancia"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"SubtituloChico"
text = "Récord: 0 m"
horizontal_alignment = 1

[node name="Carisma" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Suave"
text = "Carisma conservado: 0"
horizontal_alignment = 1

[node name="Separador" type="HSeparator" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
layout_mode = 2

[node name="Destino" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Descripcion"
text = "Faltan 2600 m para llegar al CUCosta"
horizontal_alignment = 1
autowrap_mode = 3

[node name="ListaAplausos" type="VBoxContainer" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 5

[node name="FilaTotal" type="HBoxContainer" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="Moneda" type="TextureRect" parent="Margen/Columnas/Derecha/Tarjeta/Caja/FilaTotal"]
custom_minimum_size = Vector2(52, 52)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("ico_aplauso")
expand_mode = 1
stretch_mode = 5

[node name="Total" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja/FilaTotal"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TotalResultado"
text = "+0"

[node name="Ahora" type="Label" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Suave"
text = "Saldo: 0 aplausos"
horizontal_alignment = 1

[node name="BtnVolver" type="Button" parent="Margen/Columnas/Derecha/Tarjeta/Caja"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
theme_type_variation = &"Principal"
text = "Otra vuelta"
icon = ExtResource("ico_jugar")
icon_alignment = 2
expand_icon = true

[connection signal="pressed" from="Margen/Columnas/Derecha/Tarjeta/Caja/BtnVolver" to="." method="_volver"]
