[node name="Eliminar" type="Button" parent="Margen/Raiz/Paginas/Ficha/Caja/Acciones"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Eliminar"

[node name="Aviso" type="Label" parent="Margen/Raiz"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TextoHUD"
theme_override_font_sizes/font_size = 15
autowrap_mode = 2

[node name="Confirmar" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
size = Vector2i(480, 160)
dialog_autowrap = true
cancel_button_text = "Cancelar"

[connection signal="pressed" from="Margen/Raiz/Cabecera/Volver" to="." method="_volver"]
[connection signal="pressed" from="Margen/Raiz/Paginas/Coleccion/Caja/Guardar" to="." method="_guardar"]
[connection signal="pressed" from="Margen/Raiz/Paginas/Ficha/Caja/Usar" to="." method="_usar"]
[connection signal="pressed" from="Margen/Raiz/Paginas/Ficha/Caja/Acciones/Actualizar" to="." method="_pedir_confirmacion" binds= ["actualizar"]]
[connection signal="pressed" from="Margen/Raiz/Paginas/Ficha/Caja/Acciones/Eliminar" to="." method="_pedir_confirmacion" binds= ["eliminar"]]
[connection signal="confirmed" from="Confirmar" to="." method="_confirmar"]
