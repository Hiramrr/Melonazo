[gd_scene format=3]

[ext_resource type="Script" path="res://pantallas/almanaque/almanaque.gd" id="1"]
[ext_resource type="Theme" path="res://interfaz/tema_xalapa.tres" id="tema"]
[ext_resource type="Script" path="res://interfaz/fondo_juego.gd" id="fondo"]
[ext_resource type="Script" path="res://pantallas/almanaque/ilustracion_ficha.gd" id="ilustracion"]

[node name="Almanaque" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("tema")
script = ExtResource("1")

[node name="Fondo" type="Control" parent="."]
layout_mode = 0
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("fondo")

[node name="Margen" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="Raiz" type="VBoxContainer" parent="Margen"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Cabecera" type="HBoxContainer" parent="Margen/Raiz"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Titulo" type="Label" parent="Margen/Raiz/Cabecera"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Titulo"
theme_override_font_sizes/font_size = 36
text = "Almanaque de melones"

[node name="Volver" type="Button" parent="Margen/Raiz/Cabecera"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Volver al taller"
tooltip_text = "Volver al taller. También con Esc."

[node name="Categorias" type="HBoxContainer" parent="Margen/Raiz"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MisMelones" type="Button" parent="Margen/Raiz/Categorias"]
unique_name_in_owner = true
layout_mode = 2
text = "Mis melones"

[node name="Accesorios" type="Button" parent="Margen/Raiz/Categorias"]
unique_name_in_owner = true
layout_mode = 2
text = "Accesorios"

[node name="Poderes" type="Button" parent="Margen/Raiz/Categorias"]
unique_name_in_owner = true
layout_mode = 2
text = "Poderes"

[node name="Resumen" type="Label" parent="Margen/Raiz"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TextoHUD"
theme_override_font_sizes/font_size = 16
autowrap_mode = 2

[node name="Paginas" type="HBoxContainer" parent="Margen/Raiz"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="Coleccion" type="PanelContainer" parent="Margen/Raiz/Paginas"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.15

[node name="Caja" type="VBoxContainer" parent="Margen/Raiz/Paginas/Coleccion"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Guardar" type="Button" parent="Margen/Raiz/Paginas/Coleccion/Caja"]
unique_name_in_owner = true
layout_mode = 2
text = "Guardar melón actual"

[node name="Vacio" type="Label" parent="Margen/Raiz/Paginas/Coleccion/Caja"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Suave"
text = "Aún no tienes melones guardados."
autowrap_mode = 2

[node name="Desplazamiento" type="ScrollContainer" parent="Margen/Raiz/Paginas/Coleccion/Caja"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Lista" type="GridContainer" parent="Margen/Raiz/Paginas/Coleccion/Caja/Desplazamiento"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 3

[node name="Ficha" type="PanelContainer" parent="Margen/Raiz/Paginas"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caja" type="VBoxContainer" parent="Margen/Raiz/Paginas/Ficha"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Texto" type="ScrollContainer" parent="Margen/Raiz/Paginas/Ficha/Caja"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Contenido" type="VBoxContainer" parent="Margen/Raiz/Paginas/Ficha/Caja/Texto"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Ilustracion" type="Control" parent="Margen/Raiz/Paginas/Ficha/Caja/Texto/Contenido"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 164)
layout_mode = 2
script = ExtResource("ilustracion")

[node name="Nombre" type="Label" parent="Margen/Raiz/Paginas/Ficha/Caja/Texto/Contenido"]
unique_name_in_owner = true
layout_mode = 2
