autowrap_mode = 2

[node name="Descripcion" type="Label" parent="Margen/Raiz/Paginas/Ficha/Caja/Texto/Contenido"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="Separador" type="HSeparator" parent="Margen/Raiz/Paginas/Ficha/Caja/Texto/Contenido"]
layout_mode = 2

[node name="Datos" type="Label" parent="Margen/Raiz/Paginas/Ficha/Caja/Texto/Contenido"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
autowrap_mode = 2

[node name="Usar" type="Button" parent="Margen/Raiz/Paginas/Ficha/Caja"]
unique_name_in_owner = true
layout_mode = 2
